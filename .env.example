# Nebius Token Factory API Key (Server-side only — NEVER expose to client)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Preferred Reasoning & Fast Tier Models (Auto-detected if left empty)
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_FAST_MODEL=nvidia/Nemotron-3-Nano

# Object Storage S3 Credentials for Cloud Jobs (Optional in Demo Mode)
S3_ENDPOINT=https://storage.nebius.ai
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=omni-kinetic-jobs
S3_REGION=eu-north1

# Simulation Execution Mode: 'local_demo' | 'cloud_nebius'
DEFAULT_SIM_MODE=local_demo

# Safety Gate Settings
STRICT_SAFETY_GATE=true
